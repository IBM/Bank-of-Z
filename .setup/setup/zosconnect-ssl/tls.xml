<?xml version="1.0" encoding="UTF-8"?>
<server>
    <!--
      TLS config: RACF keyring with EKU serverAuth cert (Safari-compatible).
      The cert (label 'BoZ') is generated by gencert-eku.sh using a CSR
      round-trip: keypair generated in RACF, signed by VSICA via Bouncy Castle
      with EKU serverAuth added, then imported back. Private key never leaves RACF.
    -->
    <featureManager>
        <feature>ssl-1.0</feature>
        <feature>transportSecurity-1.0</feature>
    </featureManager>
    <ssl id="defaultSSLConfig" keyStoreRef="defaultKeyStore"/>
    <keyStore id="defaultKeyStore"
              location="safkeyring://${ZOS_ADMIN_USER}/BOZRING"
              type="JCERACFKS"
              password="password"/>
</server>
